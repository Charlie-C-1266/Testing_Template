# Copy to `.env` and edit. Real environment variables always win over this file,
# so CI can override anything without touching it. `.env` is git-ignored.

# Application under test. Tests in tests/e2e/test_app_under_test.py are skipped
# while this is unset.
BASE_URL=http://localhost:8000

# Browser behaviour.
HEADLESS=true
SLOW_MO_MS=0

# Default Playwright action/assertion timeout, in milliseconds.
DEFAULT_TIMEOUT_MS=5000

# Where tests write screenshots, traces, and other keepsakes.
ARTIFACTS_DIR=artifacts
