{
  "name": "Python + uv test harness",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // Named volumes keep the uv download cache and the Playwright browser
  // binaries across container rebuilds, so a rebuild takes seconds, not minutes.
  "mounts": [
    "source=${localWorkspaceFolderBasename}-uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=${localWorkspaceFolderBasename}-playwright,target=/home/vscode/.cache/ms-playwright,type=volume"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Put the project venv that `uv sync` creates on PATH, so `pytest` and
  // `playwright` work in a plain terminal without the `uv run` prefix.
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "ms-playwright.playwright",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}
